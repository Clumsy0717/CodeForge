PORT=3000
# Create a NEW key in your OnlineCompiler.io dashboard. Do not commit your real .env file.
ONLINECOMPILER_API_KEY=PUT_YOUR_NEW_API_KEY_HERE
# Verify these compiler IDs in the OnlineCompiler.io dashboard/docs; override if needed.
